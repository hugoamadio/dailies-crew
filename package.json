{
  "name": "dailies-crew",
  "version": "0.0.0",
  "private": true,
  "description": "An open-source video factory where crews of AI agents create, direct, edit and review short videos every day.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:visual": "vitest run --config vitest.visual.config.ts",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --write .",
    "studio": "remotion studio packages/scenes/src/index.ts",
    "dailies": "tsx packages/engine/src/cli.ts"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/node": "26.6.4",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.3.0",
    "pixelmatch": "8.0.0",
    "pngjs": "7.0.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
