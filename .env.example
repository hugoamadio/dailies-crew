# Copy to .env (git-ignored) and fill in. Never commit a real key.

# The Postgres of docker-compose.yml ("npm run db:up")
DATABASE_URL=postgresql://dailies:dailies@127.0.0.1:5436/dailies

# 1 = the fake AI: free, offline, deterministic answers (tests and trying the studio out)
DAILIES_FAKE_AI=1

# With the fake AI every line also uses the silent fake voice (nothing is paid). Set 1 to let
# lines use their real voice provider (ElevenLabs, which costs money) even with the fake AI
# DAILIES_REAL_VOICE=1

# Claude API key, needed when DAILIES_FAKE_AI is not 1
ANTHROPIC_API_KEY=

# ElevenLabs key, needed by lines whose voice provider is "elevenlabs"
ELEVENLABS_API_KEY=

# Where assets, job folders and videos live (default: data/ in the repository)
DAILIES_DATA_DIR=

# Videos each crew stage works on at once (renders always run one at a time)
DAILIES_CONCURRENCY=4
